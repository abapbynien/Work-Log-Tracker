  IF zother_task_995-short_desc IS INITIAL.

    MESSAGE e016(ZNN_TASK_995).

  ENDIF.

*-------------------------------------------------------------------*
* Create
*-------------------------------------------------------------------*
  IF gv_mode = 'CREATE'.

    INSERT zother_task_995.

