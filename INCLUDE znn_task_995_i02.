*&---------------------------------------------------------------------*
*& Include          ZNN_TASK_995_I02
*&---------------------------------------------------------------------*
MODULE user_command_0110 INPUT.

  CASE sy-ucomm.

*-------------------------------------------------------------------*
* Change Button
*-------------------------------------------------------------------*
    WHEN 'CHANGE'.

      PERFORM fill_change_data.

      CASE gv_type.

        WHEN 'CR'.
          CALL SCREEN 0200.

        WHEN 'INC'.
          CALL SCREEN 0300.

        WHEN 'TASK'.
          CALL SCREEN 0400.

      ENDCASE.

*-------------------------------------------------------------------*
* Back Button
*-------------------------------------------------------------------*
    WHEN 'BACK'.

      FREE go_grid.
      FREE go_container.

      LEAVE TO SCREEN 0100.

*-------------------------------------------------------------------*
* Exit Button
*-------------------------------------------------------------------*
    WHEN 'EXIT'.

      LEAVE PROGRAM.

  ENDCASE.

ENDMODULE.
